# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/voting_system
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voting_system
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Security Keys
JWT_SECRET=your_very_long_random_secret_key_minimum_32_characters
ENCRYPTION_KEY=your_encryption_key_minimum_32_characters
INTEGRITY_KEY=your_integrity_key_minimum_32_characters
ADMIN_PASSWORD_HASH=bcrypt_hashed_password

# Server Configuration
NODE_ENV=production
PORT=3000
HTTPS_PORT=3443

# Email/SMS Configuration (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMS_API_KEY=your_sms_api_key
SMS_FROM=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1

# Session Configuration
SESSION_TIMEOUT_HOURS=2
OTP_EXPIRY_MINUTES=10
CREDENTIAL_EXPIRY_HOURS=2

# Environment
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
